# ── World Developer Portal ────────────────────────────────────────────────────
# Register your app at https://developer.worldcoin.org
NEXT_PUBLIC_WORLD_APP_ID=
APP_ID=
DEV_PORTAL_API_KEY=
WORLD_RP_ID=
RP_SIGNING_KEY=

# ── Treasury wallet (receives all WLD bet/clash payments) ─────────────────────
NEXT_PUBLIC_PULSE_TREASURY=

# ── App URL (your Vercel deployment URL, no trailing slash) ───────────────────
NEXT_PUBLIC_APP_URL=

# ── Supabase (run supabase/pulse_schema.sql in SQL editor after setup) ────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic (AI Oracle generates 8 new markets every hour) ─────────────────
ANTHROPIC_API_KEY=

# ── Vercel Cron Security (generate: openssl rand -hex 32) ────────────────────
# Vercel injects Authorization: Bearer {CRON_SECRET} on all cron calls.
# Also used to authorize /api/pulse/resolve and /api/pulse/notify.
CRON_SECRET=

# ── Treasury payout rail (sends real WLD on World Chain to winners) ──────────
# Disabled unless BOTH are set. The private key must be the signer for the
# NEXT_PUBLIC_PULSE_TREASURY wallet, holding enough WLD + ETH (gas) on chain 480.
TREASURY_PAYOUT_ENABLED=
TREASURY_PAYOUT_PRIVATE_KEY=
WORLD_CHAIN_RPC_URL=https://worldchain-mainnet.g.alchemy.com/public
